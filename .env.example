# Copy this file to the repository root as `.env` (not `backend/.env`).
# Frontend: copy `frontend/.env.local.example` to `frontend/.env.local`.
#
# Local Postgres: run `./scripts/setup-local-postgres.sh` once (creates user/db `emet` / `emet`)
DATABASE_URL=postgresql+asyncpg://emet:emet@localhost:5432/emet
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_xxx
# Set to false for local dev without Clerk Billing wired
REQUIRE_SUBSCRIPTION=false
# Clerk Billing: plan identifier used with <Protect plan="..." /> — verify same in Clerk Dashboard
CLERK_PREMIUM_PLAN_KEY=emet_subscription

# For OpenAI: leave LLM_BASE_URL empty to use OpenAI hosted WebSearchTool. For OpenRouter: set LLM_BASE_URL
# (search uses DuckDuckGo over HTTP — OpenRouter does not support OpenAI's hosted web_search tool).
# OpenRouter: put your sk-or-v1-... key in OPENAI_API_KEY. LLM_MODEL must be a single OpenRouter id
# (e.g. openai/gpt-4o-mini). Do not use openai/openai/... — that triggers a 400 invalid model id.
OPENAI_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Force deterministic mock pipeline (tests / no spend)
EMET_MOCK_PIPELINE=false

# --- Grounded search + page read (default when EMET_MCP_ENABLED=false) ---
# Uses Google Programmable Search JSON API if both are set, else DuckDuckGo text search.
# CSE: https://programmablesearchengine.google.com/  API key: Google Cloud Console
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# EMET_STRUCTURED_RESEARCH=true
# EMET_RESEARCH_TOP_URLS=5
# EMET_PAGE_EXCERPT_MAX_CHARS=6000
# EMET_FETCH_CONCURRENCY=4

# --- Optional: MCP (Model Context Protocol) for the search step ---
# When EMET_MCP_ENABLED=true, the pipeline uses MCPServerManager + tools from your server.
# Otherwise: ranked search + trafilatura (see above), or set EMET_STRUCTURED_RESEARCH=false for legacy LLM digest only.
# EMET_MCP_ENABLED=false
# EMET_MCP_TRANSPORT=stdio
# EMET_MCP_STDIO_COMMAND=npx
# EMET_MCP_STDIO_ARGS_JSON=["-y","@example/mcp-server"]
# EMET_MCP_STDIO_ENV_JSON={"BRAVE_API_KEY":"..."}
# EMET_MCP_URL=
# EMET_MCP_HEADERS_JSON={"Authorization":"Bearer ..."}
# EMET_MCP_TOOL_ALLOWLIST=search,fetch_url
# EMET_MCP_SERVER_NAME=emet_search
# EMET_MCP_STRICT_CONNECT=false
# EMET_MCP_CONNECT_TIMEOUT_SECONDS=30
# EMET_MCP_CLEANUP_TIMEOUT_SECONDS=20

# Optional: enqueue to SQS (production). Create with Terraform → copy output sqs_queue_url.
# Default EMET_RUN_PIPELINE_INLINE=true runs the pipeline in the API so progress updates without a worker.
# Set EMET_RUN_PIPELINE_INLINE=false when only worker_sqs.py / Lambda should run jobs (not both).
SQS_QUEUE_URL=
AWS_REGION=us-east-1
USE_BACKGROUND_WORKER=true
EMET_RUN_PIPELINE_INLINE=true

# After Terraform — CloudFront URL for static frontend (documentation / CORS)
CLOUDFRONT_URL=
# Backend must allow browser origins — include dev ports if Next uses 3001, plus prod frontend URL:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://xxxxxxxxxx.cloudfront.net

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_API_URL=http://localhost:8000
