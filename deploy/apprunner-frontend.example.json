{
  "ServiceName": "emet-frontend",
  "SourceConfiguration": {
    "AuthenticationConfiguration": {
      "AccessRoleArn": "arn:aws:iam::ACCOUNT_ID:role/service-role/AppRunnerECRAccessRole"
    },
    "AutoDeploymentsEnabled": false,
    "ImageRepository": {
      "ImageIdentifier": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/emet-frontend:amd64",
      "ImageRepositoryType": "ECR",
      "ImageConfiguration": {
        "Port": "3000",
        "RuntimeEnvironmentVariables": {
          "NEXT_PUBLIC_API_URL": "https://YOUR-BACKEND-SERVICE.REGION.awsapprunner.com",
          "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_...",
          "NEXT_PUBLIC_CLERK_PREMIUM_PLAN_KEY": "emet_subscription",
          "CLERK_SECRET_KEY": "sk_test_..."
        }
      }
    }
  },
  "InstanceConfiguration": {
    "Cpu": "1 vCPU",
    "Memory": "2 GB"
  },
  "HealthCheckConfiguration": {
    "Protocol": "HTTP",
    "Path": "/api/health",
    "Interval": 10,
    "Timeout": 15,
    "HealthyThreshold": 1,
    "UnhealthyThreshold": 5
  }
}
