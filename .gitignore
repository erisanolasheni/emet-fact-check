# Root app env (Clerk, DB, LLM, CORS) — use .env.example
.env
# Root-only local env files (if present)
/.env.local
/.env.*.local

# SQLite DB files may appear outside backend/; keep out of vcs
*.db

# App Runner / ECR: production NEXT_PUBLIC_* for docker build (copy from example)
/deploy/frontend-build.env

# Local App Runner JSON with real ARNs and secrets — use *.example.json in repo
/deploy/apprunner-frontend.json
/deploy/apprunner-backend.json
/deploy/apprunner-backend-update.json

# Scripts tooling
/scripts/**/__pycache__/

# See also: frontend/.gitignore, backend/.gitignore, terraform/.gitignore

.DS_Store
